# =========================================================================
# MASAKIN by Revan - Environment Variables Template
# =========================================================================
# Salin file ini menjadi ".env" di direktori yang sama dan isi nilai asli 
# sesuai dengan kredensial API dan Cloud Project Anda.
# =========================================================================

# 1. Google Gemini AI API Configuration
# Dapatkan API Key Gemini gratis Anda di: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSyYourMockOrRealGeminiApiKeyHere

# 2. Firebase Firestore Cloud Sync Configuration
# Konfigurasi ini digunakan untuk menghubungkan modul Google Cloud Sync pada Top Bar.
FIRESTORE_PROJECT_ID=masakin-by-revan
FIRESTORE_API_KEY=AIzaSyFirebaseWebApiKeyGoesHere

# 3. Google API Server Endpoints (Optional)
# Ubah jika menggunakan server proxy kustom untuk akses API dalam negeri.
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com

# 4. Local Emulator Port Settings (Development Debugging Only)
FIRESTORE_EMULATOR_HOST=localhost
FIRESTORE_EMULATOR_PORT=8080
