# =========================================================================
# MASAKIN - Environment Variables Template (Referensi Dev)
# =========================================================================
# Catatan: API Key Gemini di runtime disimpan lewat UI Settings di app
# (DataStore lokal), bukan dibaca dari file .env ini.
# =========================================================================

# Google Gemini API (referensi - masukkan di app Settings)
# https://aistudio.google.com/
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Endpoint Gemini (default)
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com

# Fallback backend (sudah dikonfigurasi di ApiService.kt)
VERCEL_BACKEND_URL=https://chef-ai-backend-blush.vercel.app/
